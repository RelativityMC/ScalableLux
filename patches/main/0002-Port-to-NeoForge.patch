diff --git a/src/main/resources/META-INF/neoforge.mods.toml b/src/main/resources/META-INF/neoforge.mods.toml
new file mode 100644
index 0000000..8d6a4f6
--- /dev/null
+++ b/src/main/resources/META-INF/neoforge.mods.toml
@@ -0,0 +1,26 @@
+modLoader="javafml"
+loaderVersion="*"
+license="LGPL-3.0-only"
+issueTrackerURL="https://github.com/RelativityMC/ScalableLux/issues"
+clientSideOnly = false
+showAsResourcePack = false
+showAsDataPack = false
+
+[[mods]]
+modId="scalablelux"
+version="${version}"
+displayName="ScalableLux"
+logoFile="assets/scalablelux/icon.png"
+authors="Spottedleaf, ishland"
+description='''Rewrites the light engine to fix lighting performance and lighting errors'''
+displayURL = "https://github.com/RelativityMC/ScalableLux"
+
+[[dependencies.scalablelux]]
+modId = "minecraft"
+type = "required"
+versionRange = "[${minecraft_version},)"
+ordering = "NONE"
+side = "BOTH"
+
+[[mixins]]
+config="scalablelux.mixins.json"
