{
  "schemaVersion": 1,
  "id": "scalablelux",
  "version": "${version}",
  "name": "ScalableLux",
  "description": "Rewrites the light engine to fix lighting performance and lighting errors",
  "authors": [
    "Spottedleaf",
    "ishland"
  ],
  "contact": {
    "issues": "https://github.com/RelativityMC/ScalableLux/issues",
    "sources": "https://github.com/RelativityMC/ScalableLux"
  },
  "provides": [
    "starlight"
  ],
  "breaks": {
    "phosphor" : "*"
  },
  "license": "LGPL-3.0-only",
  "icon": "assets/scalablelux/icon.png",
  "environment": "*",
  "entrypoints": {},
  "mixins": [
    "scalablelux.mixins.json"
  ],
  "accessWidener" : "scalablelux.accesswidener",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": ">=${minecraft_version}"
  }
}
